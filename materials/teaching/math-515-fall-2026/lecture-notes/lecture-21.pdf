   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">MATH 515: Nonlinear Dynamics -- Board Notes</rdf:li>
     <rdf:li xml:lang="en-US">MATH 515: Nonlinear Dynamics -- Board Notes</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>nonlinear dynamics</rdf:li>
     <rdf:li>scalar flows</rdf:li>
